# Copy this file to .env (cp .env.example .env) and fill in your own local values.
# docker-compose.yaml reads this file directly, so the database will not start without it.
# Note: 5433 is the HOST port mapped to the container's 5432 in docker-compose.yaml.

DB_USER=afro_food
DB_PASSWORD=change_me_locally
DB_NAME=afro_food_db
DATABASE_URL=postgresql://afro_food:change_me_locally@localhost:5433/afro_food_db
